// Tally data model. SQLite keeps the workshop offline and dependency-free.
//
// Conventions:
// - Money is always stored as integer minor units (cents, pence, yen) in `*Minor`
//   columns, next to an ISO 4217 `currency` code. Never store floats.
// - `status` columns are plain strings. The allowed values and transitions live in
//   lib/domain/*-status.ts; the database does not enforce them.
// - Every state change writes an AuditEntry (see lib/services/audit.ts).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id    String @id
  name  String
  email String @unique
  role  String // viewer | agent | admin

  auditEntries      AuditEntry[]
  paymentsRecorded  Payment[]
  creditNotesIssued CreditNote[]
  disputesOpened    Dispute[] @relation("DisputeOpenedBy")
  disputesResolved  Dispute[] @relation("DisputeResolvedBy")
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  email            String
  currency         String // default billing currency
  paymentTermsDays Int      @default(30)
  createdAt        DateTime @default(now())

  invoices    Invoice[]
  payments    Payment[]
  creditNotes CreditNote[]
  disputes    Dispute[]
}

model Invoice {
  id         String   @id @default(cuid())
  number     String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  currency   String
  status     String   @default("draft")
  issueDate  DateTime
  dueDate    DateTime
  sentAt     DateTime?
  paidAt     DateTime?
  voidedAt   DateTime?
  memo       String?

  totalMinor          Int
  amountPaidMinor     Int @default(0)
  amountCreditedMinor Int @default(0)
  // Denormalised (total - paid - credited) so the list can sort and filter on it.
  // Only lib/services/* may write it, inside the same transaction as the change.
  balanceMinor        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]
  disputes    Dispute[]

  @@index([status])
  @@index([customerId])
  @@index([dueDate])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantity       Int
  unitPriceMinor Int
  amountMinor    Int
}

model Payment {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  currency       String
  amountMinor    Int
  unappliedMinor Int // portion not allocated to any invoice (customer credit)
  method         String // bank_transfer | card | cheque
  reference      String?
  receivedAt     DateTime
  recordedById   String
  recordedBy     User     @relation(fields: [recordedById], references: [id])
  createdAt      DateTime @default(now())

  allocations PaymentAllocation[]
}

model PaymentAllocation {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amountMinor Int
  createdAt   DateTime @default(now())

  @@unique([paymentId, invoiceId])
}

model CreditNote {
  id          String   @id @default(cuid())
  number      String   @unique
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  currency    String
  amountMinor Int
  reason      String
  issuedById  String
  issuedBy    User     @relation(fields: [issuedById], references: [id])
  issuedAt    DateTime @default(now())
  disputeId   String?  @unique
  dispute     Dispute? @relation(fields: [disputeId], references: [id])
}

model Dispute {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  status      String   @default("open")
  reason      String // pricing | duplicate | not_received | quality | other
  description String
  currency    String
  amountMinor Int // amount the customer disputes, at most the invoice balance
  openedById  String
  openedBy    User     @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  openedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resolution     String? // accepted | rejected
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?       @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  creditNote     CreditNote?

  @@index([status])
}

model AuditEntry {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorLabel String // "Dana Okafor (admin)" or "system"
  entityType String // invoice | payment | credit_note | dispute
  entityId   String
  action     String // see lib/domain/audit.ts
  before     String? // JSON snapshot
  after      String? // JSON snapshot
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
